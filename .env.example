# ---- Telegram ----
# Get this from @BotFather after /newbot
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# Public HTTPS URL of the Mini App frontend (Telegram requires https, e.g. an ngrok tunnel in dev)
MINI_APP_URL=https://your-ngrok-subdomain.ngrok-free.app
# Public HTTPS URL of the API, used to set the bot webhook (e.g. another ngrok tunnel, or same host+/api)
API_PUBLIC_URL=https://your-api-ngrok-subdomain.ngrok-free.app
# Secret path segment for the webhook route, keep this random
TELEGRAM_WEBHOOK_SECRET=change-me-to-a-random-string

# ---- API ----
PORT=4000
NODE_ENV=development
DATABASE_URL="file:./dev.db"
CORS_ORIGIN=http://localhost:5173
# Comma separated list of extra allowed origins (e.g. your ngrok web tunnel)
CORS_EXTRA_ORIGINS=

# ---- AI ----
# Any OpenAI-compatible endpoint (OpenAI, Azure OpenAI gateway, OpenRouter, etc.)
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ---- Web (Vite, must be prefixed VITE_) ----
VITE_API_URL=http://localhost:4000
VITE_WS_URL=ws://localhost:4000/ws
# Your bot's @username (without @), used to build t.me invite links
VITE_BOT_USERNAME=your_bot
